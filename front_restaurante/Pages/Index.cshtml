@page
@model IndexModel

@{
    ViewData["Title"] = "Inicio";
}

@if (!Model.EstaLogueado)
{
    <div class="container" style="width: 100%; text-align: left;">

        <h3>Login</h3>

        <form method="post">

            <div style="width: 60%;">

                <div class="form-group">
                    <label class="control-label">
                        Usuario:
                    </label>

                    <input asp-for="NombreUsuario" class="form-control" />
                    <span asp-validation-for="NombreUsuario"></span>
                </div>

                <div class="form-group">
                    <label class="control-label">
                        Contraseña:
                    </label>

                    <input asp-for="Clave" type="password" class="form-control" />
                    <span asp-validation-for="Clave"></span>
                </div>

                <br />

                @if (!string.IsNullOrEmpty(Model.Mensaje))
                {
                    <div class="alert alert-danger">
                        @Model.Mensaje
                    </div>
                }
                <button type="submit"
                        asp-page-handler="BtClean"
                        class="btn btn-secondary">
                    Limpiar
                </button>

                <button type="submit"
                        asp-page-handler="BtEnter"
                        class="btn btn-primary">
                    Entrar
                </button>

            </div>

        </form>

    </div>
}
else
{
    <div class="text-center">

        <h1 class="display-4">
            Bienvenido
        </h1>

        <form method="post">

            <button type="submit"
                    asp-page-handler="BtClose"
                    class="btn btn-danger">
                Cerrar sesión
            </button>

        </form>

    </div>
}

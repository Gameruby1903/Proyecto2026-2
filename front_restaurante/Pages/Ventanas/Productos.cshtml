@page
@model ProductosModel
@{
    ViewData["Title"] = "Productos";
}
<form method="post"
      enctype="multipart/form-data">

    <div class="text-center">
        <h1 class="display-4">Productos</h1>
        <div>
            <input type="submit"
                   value="Consultar"
                   class="btn btn-secondary"
                   asp-page-handler="BtConsultar" />
            <input type="submit"
                   value="Nuevo"
                   class="btn btn-secondary"
                   asp-page-handler="BtNuevo" />
            <input type="submit"
                   value="Guardar"
                   class="btn btn-secondary"
                   asp-page-handler="BtGuardar" />
            <input id="flNombre"
                   placeholder="Nombre"
                   asp-for="@Model.Filtro!.Nombre" />
        </div>

        @if (ViewData.ContainsKey("Mensaje"))
        {
            @await Html.PartialAsync("../Emergentes/Mensajes.cshtml")
            ;
        }

        @if (Model.Formulario || Model.Borrar)
        {
            <input type="hidden"
                   asp-for="@Model.Actual!.Id" />
        }

        @if (Model.Formulario)
        {
            <div>
                <h3>Productos</h3>

                <label>
                    Nombre
                </label>
                <input id="nmNombre"
                       asp-for="@Model.Actual!.Nombre" />
                <br />

                <label>
                    Descripcion
                </label>
                <input id="nmDescripcion"
                       asp-for="@Model.Actual!.Descripcion" />
                <br />

                <label>
                    Precio
                </label>
                <input id="nmPrecio"
                       type="number"
                       min="1"
                       step="1"
                       asp-for="@Model.Actual!.Precio" />
                <br />

                <label>
                    Disponible
                </label>
                <select id="nmDisponible"
                        asp-for="@Model.Actual!.Disponible">
                    <option value="true">Sí</option>
                    <option value="false">No</option>
                </select>
                <br />

                <label>Categorias:</label>
                <select asp-for="Actual.Categoria"
                        asp-items="@(new SelectList(Model.Categorias, "Id", "Nombre"))">
                    <option value="">Seleccione una categoría</option>
                </select>
                <br />
                
                <label>
                    Imagen
                </label>
                @if (Model.Actual!.Imagen != null)
                {
                    <img height="100"
                         width="100"
                         src="data:image;base64,
                    @System.Convert.ToBase64String(
                    Convert.FromBase64String(
                    Model.Actual!.Imagen))" />
                }
                <input type="file"
                       asp-for="FormFile" />
            </div>
        }

        @if (Model.Borrar)
        {
            <div class="popup">
                <div class="pp_del_inner">
                    <h3>
                        Mensaje
                    </h3>

                    <h4>
                        ¿Quiere borrar el Producto con información
                        @Model.Actual!.Nombre,
                        @Model.Actual!.Descripcion,
                        @Model.Actual!.Precio?
                    </h4>
                    <input type="submit"
                           value="Cancelar"
                           class="btn btn-secondary"
                           asp-page-handler="BtConsultar" />
                    <input type="submit"
                           value="Borrar"
                           class="btn btn-secondary"
                           asp-page-handler="BtBorrar" />
                </div>
            </div>
        }

        @if (!Model.Formulario)
        {
            <br />
            <br />
            <div class="containers_vn panel panel-default">
                <table class="tb_data table table-striped table-bordered table-hover">
                    <tr>
                        <th>Nombre</th>
                        <th>Descripcion</th>
                        <th>Disponible</th>
                        <th>Precio</th>
                        <th>Categoria</th>
                        <th>Imagen</th>
                        <th>Acción</th>

                    </tr>
                    @if (Model != null && Model.Lista != null)
                    {
                        foreach (var elemento in Model.Lista)
                        {
                            <tr>
                                <td>@elemento.Nombre</td>
                                <td>@elemento.Descripcion</td>
                                <td>@(elemento.Disponible ? "Sí" : "No")</td>
                                <td>@elemento.Precio</td>
                                <td>@elemento.Categoria</td>
								<td>
									@if (elemento.Imagen != null)
									{
										<img height="60"
											 width="60"
											 src="data:image;base64,
										@System.Convert.ToBase64String(
										Convert.FromBase64String(elemento.Imagen))" />
									}
                                <td>
                                    <input type="submit"
                                           value="Editar"
                                           class="btn btn-secondary"
                                           asp-page-handler="BtEditar"
                                           asp-route-data="@elemento.Id" />
                                    <input type="submit"
                                           value="Borrar"
                                           class="btn btn-secondary"
                                           asp-page-handler="BtPregBorrar"
                                           asp-route-data="@elemento.Id" />
                                </td>
                            </tr>
                        }
                    }
                </table>
            </div>
        }

    </div>
</form>
@page
@model TurnosModel
@{
    ViewData["Title"] = "Turnos";
}
<form method="post"
      enctype="multipart/form-data">

    <div class="text-center">
        <h1 class="display-4">Turnos</h1>
        <div>
            <input type="submit"
                   value="Consultar"
                   class="btn btn-secondary"
                   asp-page-handler="BtConsultar" />
            <input type="submit"
                   value="Nuevo"
                   class="btn btn-secondary"
                   asp-page-handler="BtNuevo" />
            <input type="submit"
                   value="Guardar"
                   class="btn btn-secondary"
                   asp-page-handler="BtGuardar" />
            <input id="flNombre"
                   placeholder="Nombre"
                   asp-for="@Model.Filtro!.Nombre" />
        </div>

        @if (ViewData.ContainsKey("Mensaje"))
        {
            @await Html.PartialAsync("../Emergentes/Mensajes.cshtml")
            ;
        }

        @if (Model.Formulario || Model.Borrar)
        {
            <input type="hidden"
                   asp-for="@Model.Actual!.Id" />
        }

        @if (Model.Formulario)
        {
            <div>
                <h3>Turnos</h3>

                <label>
                    Empleado
                </label>
                <input id="nmEmpleado"
                       asp-for="@Model.Actual!.Empleado" />
                <br />

                <label>
                    Fecha Inicio
                </label>
                <input id="nmFechaInicio"
                       asp-for="@Model.Actual!.FechaInicio" />
                <br />

                <label>
                    Fecha Fin
                </label>
                <input id="nmFechaFin"
                       asp-for="@Model.Actual!.FechaFin" />
                <br />

                <label>
                    Nombre
                </label>
                <input id="nmNombre"
                       asp-for="@Model.Actual!.Nombre" />
                <br />
            </div>
        }

        @if (Model.Borrar)
        {
            <div class="popup">
                <div class="pp_del_inner">
                    <h3>
                        Mensaje
                    </h3>

                    <h4>
                        ¿Quiere borrar el Turno con información

                        @Model.Actual!.Empleado,
                        @Model.Actual!.FechaInicio,
                        @Model.Actual!.FechaFin,
                        @Model.Actual!.Nombre?

                    </h4>
                    <input type="submit"
                           value="Cancelar"
                           class="btn btn-secondary"
                           asp-page-handler="BtConsultar" />
                    <input type="submit"
                           value="Borrar"
                           class="btn btn-secondary"
                           asp-page-handler="BtBorrar" />
                </div>
            </div>
        }

        @if (!Model.Formulario)
        {
            <br />
            <br />
            <div class="containers_vn panel panel-default">
                <table class="tb_data table table-striped table-bordered table-hover">
                    <tr>
                        <th>Empleado</th>
                        <th>Fecha Inicio</th>
                        <th>Fecha Fin</th>
                        <th>Nombre</th>
                    </tr>
                    @if (Model != null && Model.Lista != null)
                    {
                        foreach (var elemento in Model.Lista)
                        {
                            <tr>
                                <td>@elemento.Empleado</td>
                                <td>@elemento.FechaInicio</td>
                                <td>@elemento.FechaFin</td>
                                <td>@elemento.Nombre</td>

                                <td>
                                    <input type="submit"
                                           value="Editar"
                                           class="btn btn-secondary"
                                           asp-page-handler="BtEditar"
                                           asp-route-data="@elemento.Id" />
                                    <input type="submit"
                                           value="Borrar"
                                           class="btn btn-secondary"
                                           asp-page-handler="BtPregBorrar"
                                           asp-route-data="@elemento.Id" />
                                </td>
                            </tr>
                        }
                    }
                </table>
            </div>
        }

    </div>
</form>
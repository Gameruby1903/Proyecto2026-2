@page
@model ResenasModel
@{
    ViewData["Title"] = "Reseñas";
}
<form method="post"
      enctype="multipart/form-data">

    <div class="text-center">
        <h1 class="display-4">Reseñas</h1>
        <div>
            <input type="submit"
                   value="Consultar"
                   class="btn btn-secondary"
                   asp-page-handler="BtConsultar" />
            <input type="submit"
                   value="Nuevo"
                   class="btn btn-secondary"
                   asp-page-handler="BtNuevo" />
            <input type="submit"
                   value="Guardar"
                   class="btn btn-secondary"
                   asp-page-handler="BtGuardar" />
            <input id="flComentario"
                   placeholder="Comentario"
                   asp-for="@Model.Filtro!.Comentario" />
        </div>

        @if (ViewData.ContainsKey("Mensaje"))
        {
            @await Html.PartialAsync("../Emergentes/Mensajes.cshtml")
            ;
        }

        @if (Model.Formulario || Model.Borrar)
        {
            <input type="hidden"
                   asp-for="@Model.Actual!.Id" />
        }

        @if (Model.Formulario)
        {
            <div>
                <h3>Reseñas</h3>

                <label>
                    Cliente
                </label>
                <input id="nmCliente"
                       asp-for="@Model.Actual!.Cliente" />
                <br />

                <label>
                    Producto
                </label>
                <input id="nmProducto"
                       asp-for="@Model.Actual!.Producto" />
                <br />

                <label>
                    Calificación
                </label>
                <input id="nmCalificacion"
                       asp-for="@Model.Actual!.Calificacion" />
                <br />

                <label>
                    Comentario
                </label>
                <input id="nmComentario"
                       asp-for="@Model.Actual!.Comentario" />
                <br />

                <label>
                    Fecha
                </label>
                <input id="nmFecha"
                       asp-for="@Model.Actual!.Fecha" />
                <br />
            </div>
        }

        @if (Model.Borrar)
        {
            <div class="popup">
                <div class="pp_del_inner">
                    <h3>
                        Mensaje
                    </h3>

                    <h4>
                        ¿Quiere borrar la Reseña con información

                        @Model.Actual!.Cliente,
                        @Model.Actual!.Producto,
                        @Model.Actual!.Calificacion,
                        @Model.Actual!.Comentario,
                        @Model.Actual!.Fecha?

                    </h4>
                    <input type="submit"
                           value="Cancelar"
                           class="btn btn-secondary"
                           asp-page-handler="BtConsultar" />
                    <input type="submit"
                           value="Borrar"
                           class="btn btn-secondary"
                           asp-page-handler="BtBorrar" />
                </div>
            </div>
        }

        @if (!Model.Formulario)
        {
            <br />
            <br />
            <div class="containers_vn panel panel-default">
                <table class="tb_data table table-striped table-bordered table-hover">
                    <tr>
                        <th>Cliente</th>
                        <th>Producto</th>
                        <th>Calificación</th>
                        <th>Comentario</th>
                        <th>Fecha</th>
                    </tr>
                    @if (Model != null && Model.Lista != null)
                    {
                        foreach (var elemento in Model.Lista)
                        {
                            <tr>
                                <td>@elemento.Cliente</td>
                                <td>@elemento.Producto</td>
                                <td>@elemento.Calificacion</td>
                                <td>@elemento.Comentario</td>
                                <td>@elemento.Fecha</td>

                                <td>
                                    <input type="submit"
                                           value="Editar"
                                           class="btn btn-secondary"
                                           asp-page-handler="BtEditar"
                                           asp-route-data="@elemento.Id" />
                                    <input type="submit"
                                           value="Borrar"
                                           class="btn btn-secondary"
                                           asp-page-handler="BtPregBorrar"
                                           asp-route-data="@elemento.Id" />
                                </td>
                            </tr>
                        }
                    }
                </table>
            </div>
        }

    </div>
</form>
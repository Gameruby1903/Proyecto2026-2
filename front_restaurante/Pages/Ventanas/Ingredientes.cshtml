@page
@model IngredientesModel
@{
    ViewData["Title"] = "Ingredientes";
}
<form method="post"
    enctype="multipart/form-data">

    <div class="text-center">
        <h1 class="display-4">Ingredientes</h1>
        <div>
            <input type="submit"
                value="Consultar"
                class="btn btn-secondary"
                asp-page-handler="BtConsultar"/>
            <input type="submit"
                value="Nuevo"
                class="btn btn-secondary"
                asp-page-handler="BtNuevo"/>
            <input type="submit"
                value="Guardar"
                class="btn btn-secondary"
                asp-page-handler="BtGuardar"/>
            <input id="flNombre" 
                placeholder="Nombre"
                asp-for="@Model.Filtro!.Nombre"/>
        </div>

        @if (ViewData.ContainsKey("Mensaje"))
        {
            @await Html.PartialAsync("../Emergentes/Mensajes.cshtml");
        }
        
        @if (Model.Formulario || Model.Borrar)
        {
            <input type="hidden"
                asp-for="@Model.Actual!.Id" />
        }

        @if (Model.Formulario)
        {
            <div>
                <h3>Ingredientes</h3>

               

                <label>
                    Nombre
                </label>
                <input id="nmNombre"
                    asp-for="@Model.Actual!.Nombre"/>
                <br />
                <label>
                    Unidad de Medida
                </label>
                <input id="nmUniMedida"
                       asp-for="@Model.Actual!.UniMedida" />
                <br />

                <label>
                    Costo Unitario
                </label>
                <input id="nmCostoUni"
                       asp-for="@Model.Actual!.CostoUni" />
                <br />
               
            </div>
        }

        @if (Model.Borrar)
        {
            <div class="popup">
                <div class="pp_del_inner">
                    <h3>
                        Mensaje
                    </h3>

                    <h4>
                        ¿Quiere borrar el Ingrediente con información 
                            
                        @Model.Actual!.Nombre,
                        @Model.Actual!.UniMedida,
                        @Model.Actual!.CostoUni?


                            
                           
                    </h4>
                    <input type="submit"
                        value="Cancelar"
                        class="btn btn-secondary"
                        asp-page-handler="BtConsultar"/>
                    <input type="submit"
                        value="Borrar"
                        class="btn btn-secondary"
                        asp-page-handler="BtBorrar"/>
                </div>
            </div>
        }

        @if (!Model.Formulario)
        {
            <br />
            <br />
            <div class="containers_vn panel panel-default">
                <table class="tb_data table table-striped table-bordered table-hover">
                    <tr>
                        
                        <th>Nombre</th>
                        <th>Unidad de Medida</th>
                        <th>Costo Unitario</th>
                       
                    </tr>
                    @if (Model != null && Model.Lista != null)
                    {
                        foreach (var elemento in Model.Lista)
                        {
                            <tr>
                                
                                <td>@elemento.Nombre</td>
                                <td>@elemento.UniMedida</td>
                                <td>@elemento.CostoUni</td>
                         
                                <td>
                                    <input type="submit"
                                        value="Editar"
                                        class="btn btn-secondary"
                                        asp-page-handler="BtEditar"
                                        asp-route-data="@elemento.Id"/>
                                    <input type="submit"
                                        value="Borrar"
                                        class="btn btn-secondary"
                                        asp-page-handler="BtPregBorrar"
                                        asp-route-data="@elemento.Id"/>
                                </td>
                            </tr>
                        }
                    }
                </table>
            </div>
        }

        </div>
</form>
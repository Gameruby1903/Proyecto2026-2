@page
@model DetallePedidosModel
@{
    ViewData["Title"] = "Detalle Pedidos";
}
<form method="post"
    enctype="multipart/form-data">
    
    <div class="text-center">
        <h1 class="display-4">Detalle Pedidos</h1>
        <div>
            <input type="submit"
                value="Consultar"
                class="btn btn-secondary"
                asp-page-handler="BtConsultar"/>
            <input type="submit"
                value="Nuevo"
                class="btn btn-secondary"
                asp-page-handler="BtNuevo"/>
            <input type="submit"
                value="Guardar"
                class="btn btn-secondary"
                asp-page-handler="BtGuardar"/>
            <input id="flPedido" 
                placeholder="Cantidad"
                   asp-for="@Model.Filtro!.Cantidad" />
        </div>

        @if (ViewData.ContainsKey("Mensaje"))
        {
            @await Html.PartialAsync("../Emergentes/Mensajes.cshtml");
        }
        
        @if (Model.Formulario || Model.Borrar)
        {
            <input type="hidden"
                asp-for="@Model.Actual!.Id" />
        }

        @if (Model.Formulario)
        {
            <div>
                <h3>Detalle Pedidos</h3>

               

                <label>
                    Pedido
                </label>
                <input id="nmPedido"
                    asp-for="@Model.Actual!.Pedido"/>
                <br />
                <label>
                    Producto
                </label>
                <input id="nmProducto"
                       asp-for="@Model.Actual!.Producto" />
                <br />

                <label>
                    Cantidad
                </label>
                <input id="nmCantidad"
                       asp-for="@Model.Actual!.Cantidad" />
                <br />

                <label>
                    PrecioUni
                </label>
                <input id="nmPrecioUni"
                    asp-for="@Model.Actual!.PrecioUni"/>
                <br />

               
            </div>
        }

        @if (Model.Borrar)
        {
            <div class="popup">
                <div class="pp_del_inner">
                    <h3>
                        Mensaje
                    </h3>

                    <h4>
                        ¿Quiere borrar la Categoria con información 
                            
                        @Model.Actual!.Pedido,
                        @Model.Actual!.Producto,
                        @Model.Actual!.Cantidad,
                        @Model.Actual!.PrecioUni?

                            
                           
                    </h4>
                    <input type="submit"
                        value="Cancelar"
                        class="btn btn-secondary"
                        asp-page-handler="BtConsultar"/>
                    <input type="submit"
                        value="Borrar"
                        class="btn btn-secondary"
                        asp-page-handler="BtBorrar"/>
                </div>
            </div>
        }

        @if (!Model.Formulario)
        {
            <br />
            <br />
            <div class="containers_vn panel panel-default">
                <table class="tb_data table table-striped table-bordered table-hover">
                    <tr>
                        
                        <th>Pedido</th>
                        <th>Producto</th>
                        <th>Cantidad</th>
                        <th>PrecioUni</th>
                       
                    </tr>
                    @if (Model != null && Model.Lista != null)
                    {
                        foreach (var elemento in Model.Lista)
                        {
                            <tr>
                                
                                <td>@elemento.Pedido</td>
                                <td>@elemento.Producto</td>
                                <td>@elemento.Cantidad</td>
                                <td>@elemento.PrecioUni</td>
                         
                                <td>
                                    <input type="submit"
                                        value="Editar"
                                        class="btn btn-secondary"
                                        asp-page-handler="BtEditar"
                                        asp-route-data="@elemento.Id"/>
                                    <input type="submit"
                                        value="Borrar"
                                        class="btn btn-secondary"
                                        asp-page-handler="BtPregBorrar"
                                        asp-route-data="@elemento.Id"/>
                                </td>
                            </tr>
                        }
                    }
                </table>
            </div>
        }

        </div>
</form>
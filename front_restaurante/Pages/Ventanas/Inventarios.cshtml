@page
@model InventariosModel
@{
    ViewData["Title"] = "Inventarios";
}
<form method="post"
    enctype="multipart/form-data">

    <div class="text-center">
        <h1 class="display-4">Categorias</h1>
        <div>
            <input type="submit"
                value="Consultar"
                class="btn btn-secondary"
                asp-page-handler="BtConsultar"/>
            <input type="submit"
                value="Nuevo"
                class="btn btn-secondary"
                asp-page-handler="BtNuevo"/>
            <input type="submit"
                value="Guardar"
                class="btn btn-secondary"
                asp-page-handler="BtGuardar"/>
            <input id="flCantDisponible" 
                placeholder="Cantidad Disponible"
                asp-for="@Model.Filtro!.CantDisponible"/>
        </div>

        @if (ViewData.ContainsKey("Mensaje"))
        {
            @await Html.PartialAsync("../Emergentes/Mensajes.cshtml");
        }
        
        @if (Model.Formulario || Model.Borrar)
        {
            <input type="hidden"
                asp-for="@Model.Actual!.Id" />
        }

        @if (Model.Formulario)
        {
            <div>
                <h3>Inventarios</h3>

               

                <label>
                    Cantidad Disponible
                </label>
                <input id="nmCantDisponible"
                    asp-for="@Model.Actual!.CantDisponible"/>
                <br />
                <label>
					Cantidad Minima
                </label>
                <input id="nmCantMinima"
                       asp-for="@Model.Actual!.CantMinima" />
                <br />

                <label>
                    Ultima Actualización
                </label>
                <input id="nmUltimaActu"
                       asp-for="@Model.Actual!.UltimaActu" />
                <br />
               
            </div>
        }

        @if (Model.Borrar)
        {
            <div class="popup">
                <div class="pp_del_inner">
                    <h3>
                        Mensaje
                    </h3>

                    <h4>
                        ¿Quiere borrar el Inventario con información 
                            
                        @Model.Actual!.CantDisponible,
                        @Model.Actual!.CantMinima,
                        @Model.Actual!.UltimaActu

                            
                           
                    </h4>
                    <input type="submit"
                        value="Cancelar"
                        class="btn btn-secondary"
                        asp-page-handler="BtConsultar"/>
                    <input type="submit"
                        value="Borrar"
                        class="btn btn-secondary"
                        asp-page-handler="BtBorrar"/>
                </div>
            </div>
        }

        @if (!Model.Formulario)
        {
            <br />
            <br />
            <div class="containers_vn panel panel-default">
                <table class="tb_data table table-striped table-bordered table-hover">
                    <tr>
                        
                        <th>Cantidad Disponible</th>
                        <th>Cantidad Minima</th>
                        <th>Ultima Actualización</th>
                       
                    </tr>
                    @if (Model != null && Model.Lista != null)
                    {
                        foreach (var elemento in Model.Lista)
                        {
                            <tr>
                                
                                <td>@elemento.CantDisponible</td>
                                <td>@elemento.CantMinima</td>
                                <td>@elemento.UltimaActu</td>

                         
                                <td>
                                    <input type="submit"
                                        value="Editar"
                                        class="btn btn-secondary"
                                        asp-page-handler="BtEditar"
                                        asp-route-data="@elemento.Id"/>
                                    <input type="submit"
                                        value="Borrar"
                                        class="btn btn-secondary"
                                        asp-page-handler="BtPregBorrar"
                                        asp-route-data="@elemento.Id"/>
                                </td>
                            </tr>
                        }
                    }
                </table>
            </div>
        }

        </div>
</form>
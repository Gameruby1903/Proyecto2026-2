@page
@model MesasModel
@{
    ViewData["Title"] = "Mesas";
}
<form method="post"
    enctype="multipart/form-data">

    <div class="text-center">
        <h1 class="display-4">Mesas</h1>
        <div>
            <input type="submit"
                value="Consultar"
                class="btn btn-secondary"
                asp-page-handler="BtConsultar"/>
            <input type="submit"
                value="Nuevo"
                class="btn btn-secondary"
                asp-page-handler="BtNuevo"/>
            <input type="submit"
                value="Guardar"
                class="btn btn-secondary"
                asp-page-handler="BtGuardar"/>
            <input id="flNumero" 
                placeholder="Número"
                asp-for="@Model.Filtro!.Numero"/>
        </div>

        @if (ViewData.ContainsKey("Mensaje"))
        {
            @await Html.PartialAsync("../Emergentes/Mensajes.cshtml");
        }
        
        @if (Model.Formulario || Model.Borrar)
        {
            <input type="hidden"
                asp-for="@Model.Actual!.Id" />
        }

        @if (Model.Formulario)
        {
            <div>
                <h3>Categorias</h3>

               

                <label>
                    Número
                </label>
                <input id="nmNumero"
                    asp-for="@Model.Actual!.Numero"/>
                <br />
                <label>
                    Capacidad
                </label>
                <input id="nmCapacidad"
                       asp-for="@Model.Actual!.Capacidad" />
                <br />

                <label>
                    Estado
                </label>
                <input id="nmEstado"
                       asp-for="@Model.Actual!.Estado" />
                <br />

                <label>
                    Ubicación
                </label>
                <input id="nmUbicacion"
                    asp-for="@Model.Actual!.Ubicacion"/>
                <br />

               
            </div>
        }

        @if (Model.Borrar)
        {
            <div class="popup">
                <div class="pp_del_inner">
                    <h3>
                        Mensaje
                    </h3>

                    <h4>
                        ¿Quiere borrar la Mesa con información 
                            
                        @Model.Actual!.Numero,
                        @Model.Actual!.Capacidad,
                        @Model.Actual!.Estado,
                        @Model.Actual!.Ubicacion

                            
                           
                    </h4>
                    <input type="submit"
                        value="Cancelar"
                        class="btn btn-secondary"
                        asp-page-handler="BtConsultar"/>
                    <input type="submit"
                        value="Borrar"
                        class="btn btn-secondary"
                        asp-page-handler="BtBorrar"/>
                </div>
            </div>
        }

        @if (!Model.Formulario)
        {
            <br />
            <br />
            <div class="containers_vn panel panel-default">
                <table class="tb_data table table-striped table-bordered table-hover">
                    <tr>
                        
                        <th>Número</th>
                        <th>Capacidad</th>
                        <th>Estado</th>
                        <th>Ubicación</th>
                       
                    </tr>
                    @if (Model != null && Model.Lista != null)
                    {
                        foreach (var elemento in Model.Lista)
                        {
                            <tr>
                                
                                <td>@elemento.Numero</td>
                                <td>@elemento.Capacidad</td>
                                <td>@elemento.Estado</td>
                                <td>@elemento.Ubicacion</td>
                         
                                <td>
                                    <input type="submit"
                                        value="Editar"
                                        class="btn btn-secondary"
                                        asp-page-handler="BtEditar"
                                        asp-route-data="@elemento.Id"/>
                                    <input type="submit"
                                        value="Borrar"
                                        class="btn btn-secondary"
                                        asp-page-handler="BtPregBorrar"
                                        asp-route-data="@elemento.Id"/>
                                </td>
                            </tr>
                        }
                    }
                </table>
            </div>
        }

        </div>
</form>
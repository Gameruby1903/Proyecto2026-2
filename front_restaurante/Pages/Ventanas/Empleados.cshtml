@page
@model EmpleadosModel
@{
    ViewData["Title"] = "Empleados";
}
<form method="post"
    enctype="multipart/form-data">

    <div class="text-center">
        <h1 class="display-4">Empleados</h1>
        <div>
            <input type="submit"
                value="Consultar"
                class="btn btn-secondary"
                asp-page-handler="BtConsultar"/>
            <input type="submit"
                value="Nuevo"
                class="btn btn-secondary"
                asp-page-handler="BtNuevo"/>
            <input type="submit"
                value="Guardar"
                class="btn btn-secondary"
                asp-page-handler="BtGuardar"/>
           
            <input id="flNombre" 
                   placeholder="Nombre"
                   asp-for="@Model.Filtro!.Nombre" />
        </div>

        @if (ViewData.ContainsKey("Mensaje"))
        {
            @await Html.PartialAsync("../Emergentes/Mensajes.cshtml");
        }
        
        @if (Model.Formulario || Model.Borrar)
        {
            <input type="hidden"
                asp-for="@Model.Actual!.Id" />
        }

        @if (Model.Formulario)
        {
            <div>
                <h3>Empleados</h3>

               

                <label>
                    Nombre
                </label>
                <input id="nmNombre"
                    asp-for="@Model.Actual!.Nombre"/>
                <br />
                <label>
                    Cédula
                </label>
                <input id="nmCedula"
                       asp-for="@Model.Actual!.Cedula" />
                <br />

                <label>
                    Telefono
                </label>
                <input id="nmTelefono"
                       asp-for="@Model.Actual!.Telefono" />
                <br />

                <label>
                    FechaContratacion
                </label>
                <input id="nmFechaContratacion"
                    asp-for="@Model.Actual!.FechaContratacion"/>
                <br />

                <label>
                    TipoEmpleado
                </label>
                <input id="nmTipoEmpleado"
                       asp-for="@Model.Actual!.TipoEmpleado" />
                <br />
                <label>
                    Sucursal
                </label>
                <input id="nmSucursal"
                       asp-for="@Model.Actual!.Sucursal" />
                <br />
               
            </div>
        }

        @if (Model.Borrar)
        {
            <div class="popup">
                <div class="pp_del_inner">
                    <h3>
                        Mensaje
                    </h3>

                    <h4>
                        ¿Quiere borrar la Categoria con información 
                            
                        @Model.Actual!.Nombre,
                        @Model.Actual!.Cedula,
                        @Model.Actual!.Telefono,
                        @Model.Actual!.FechaContratacion,
                        @Model.Actual!.TipoEmpleado,
                        @Model.Actual!.Sucursal?

                            
                           
                    </h4>
                    <input type="submit"
                        value="Cancelar"
                        class="btn btn-secondary"
                        asp-page-handler="BtConsultar"/>
                    <input type="submit"
                        value="Borrar"
                        class="btn btn-secondary"
                        asp-page-handler="BtBorrar"/>
                </div>
            </div>
        }

        @if (!Model.Formulario)
        {
            <br />
            <br />
            <div class="containers_vn panel panel-default">
                <table class="tb_data table table-striped table-bordered table-hover">
                    <tr>
                        
                        <th>Nombre</th>
                        <th>Cedula</th>
                        <th>Telefono</th>
                        <th>FechaContratacion</th>
                        <th>TipoEmpleado</th>
                        <th>Sucursal</th>
                    </tr>
                    @if (Model != null && Model.Lista != null)
                    {
                        foreach (var elemento in Model.Lista)
                        {
                            <tr>
                                
                                <td>@elemento.Nombre</td>
                                <td>@elemento.Cedula</td>
                                <td>@elemento.Telefono</td>
                                <td>@elemento.FechaContratacion</td>
                                <td>@elemento.TipoEmpleado</td>
                                <td>@elemento.Sucursal</td>
                         
                                <td>
                                    <input type="submit"
                                        value="Editar"
                                        class="btn btn-secondary"
                                        asp-page-handler="BtEditar"
                                        asp-route-data="@elemento.Id"/>
                                    <input type="submit"
                                        value="Borrar"
                                        class="btn btn-secondary"
                                        asp-page-handler="BtPregBorrar"
                                        asp-route-data="@elemento.Id"/>
                                </td>
                            </tr>
                        }
                    }
                </table>
            </div>
        }

        </div>
</form>
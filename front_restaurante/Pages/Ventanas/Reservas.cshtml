@page
@model ReservasModel
@{
    ViewData["Title"] = "Reservas";
}
<form method="post"
      enctype="multipart/form-data">

    <div class="text-center">
        <h1 class="display-4">Reservas</h1>
        <div>
            <input type="submit"
                   value="Consultar"
                   class="btn btn-secondary"
                   asp-page-handler="BtConsultar" />
            <input type="submit"
                   value="Nuevo"
                   class="btn btn-secondary"
                   asp-page-handler="BtNuevo" />
            <input type="submit"
                   value="Guardar"
                   class="btn btn-secondary"
                   asp-page-handler="BtGuardar" />
            <input id="flEstado"
                   placeholder="Estado"
                   asp-for="@Model.Filtro!.Estado" />
        </div>

        @if (ViewData.ContainsKey("Mensaje"))
        {
            @await Html.PartialAsync("../Emergentes/Mensajes.cshtml")
            ;
        }

        @if (Model.Formulario || Model.Borrar)
        {
            <input type="hidden"
                   asp-for="@Model.Actual!.Id" />
        }

        @if (Model.Formulario)
        {
            <div>
                <h3>Reservas</h3>

                <label>
                    Cliente
                </label>
                <input id="nmCliente"
                       asp-for="@Model.Actual!.Cliente" />
                <br />

                <label>
                    Mesa
                </label>
                <input id="nmMesa"
                       asp-for="@Model.Actual!.Mesa" />
                <br />

                <label>
                    Fecha y Hora
                </label>
                <input id="nmFechaHora"
                       asp-for="@Model.Actual!.FechaHora" />
                <br />

                <label>
                    Número de Personas
                </label>
                <input id="nmNPersonas"
                       asp-for="@Model.Actual!.NPersonas" />
                <br />

                <label>
                    Estado
                </label>
                <input id="nmEstado"
                       asp-for="@Model.Actual!.Estado" />
                <br />
            </div>
        }

        @if (Model.Borrar)
        {
            <div class="popup">
                <div class="pp_del_inner">
                    <h3>
                        Mensaje
                    </h3>

                    <h4>
                        ¿Quiere borrar la Reserva con información

                        @Model.Actual!.Cliente,
                        @Model.Actual!.Mesa,
                        @Model.Actual!.FechaHora,
                        @Model.Actual!.NPersonas,
                        @Model.Actual!.Estado?

                    </h4>
                    <input type="submit"
                           value="Cancelar"
                           class="btn btn-secondary"
                           asp-page-handler="BtConsultar" />
                    <input type="submit"
                           value="Borrar"
                           class="btn btn-secondary"
                           asp-page-handler="BtBorrar" />
                </div>
            </div>
        }

        @if (!Model.Formulario)
        {
            <br />
            <br />
            <div class="containers_vn panel panel-default">
                <table class="tb_data table table-striped table-bordered table-hover">
                    <tr>
                        <th>Cliente</th>
                        <th>Mesa</th>
                        <th>Fecha y Hora</th>
                        <th>Número de Personas</th>
                        <th>Estado</th>
                    </tr>
                    @if (Model != null && Model.Lista != null)
                    {
                        foreach (var elemento in Model.Lista)
                        {
                            <tr>
                                <td>@elemento.Cliente</td>
                                <td>@elemento.Mesa</td>
                                <td>@elemento.FechaHora</td>
                                <td>@elemento.NPersonas</td>
                                <td>@elemento.Estado</td>

                                <td>
                                    <input type="submit"
                                           value="Editar"
                                           class="btn btn-secondary"
                                           asp-page-handler="BtEditar"
                                           asp-route-data="@elemento.Id" />
                                    <input type="submit"
                                           value="Borrar"
                                           class="btn btn-secondary"
                                           asp-page-handler="BtPregBorrar"
                                           asp-route-data="@elemento.Id" />
                                </td>
                            </tr>
                        }
                    }
                </table>
            </div>
        }

    </div>
</form>
@page
@model ResenasModel
@{
    ViewData["Title"] = "Reseñas";
}
<form method="post"
      enctype="multipart/form-data">

    <div class="text-center">
        <h1 class="display-4">Reseñas</h1>
        <div>
            <input type="submit"
                   value="Consultar"
                   class="btn btn-secondary"
                   asp-page-handler="BtConsultar" />
            <input type="submit"
                   value="Nuevo"
                   class="btn btn-secondary"
                   asp-page-handler="BtNuevo" />
            <input type="submit"
                   value="Guardar"
                   class="btn btn-secondary"
                   asp-page-handler="BtGuardar" />
            <input id="flComentario"
                   placeholder="Comentario"
                   asp-for="@Model.Filtro!.Comentario" />
        </div>

        @if (ViewData.ContainsKey("Mensaje"))
        {
            @await Html.PartialAsync("../Emergentes/Mensajes.cshtml")
            ;
        }

        @if (Model.Formulario || Model.Borrar)
        {
            <input type="hidden"
                   asp-for="@Model.Actual!.Id" />
        }

        @if (Model.Formulario)
        {
            <div>
                <h3>Reseñas</h3>

                <label>CLientes:</label>
                <select asp-for="Actual.Cliente"
                        asp-items="@(new SelectList(Model.Clientes, "Id", "Nombre"))">
                    <option value="">Seleccione un cliente</option>
                </select>
                <br />

                <label>Productos:</label>
                <select asp-for="Actual.Producto"
                        asp-items="@(new SelectList(Model.Productos, "Id", "Nombre"))">
                    <option value="">Seleccione un producto</option>
                </select>
                <br />
                <label>
                    Calificación
                </label>
                <select id="nmCalificacion"
                        asp-for="@Model.Actual!.Calificacion">
                    <option value="1">1</option>
                    <option value="2">2</option>
                    <option value="3">3</option>
                    <option value="4">4</option>
                    <option value="5">5</option>
                </select>
                <br />

                <label>
                    Comentario
                </label>
                <input id="nmComentario"
                       asp-for="@Model.Actual!.Comentario" />
                <br />

                <label>
                    Fecha
                </label>
                <input id="nmFecha"
                       type="datetime-local"
                       asp-for="@Model.Actual!.Fecha" />
                <br />
                <label>
                    Imagen
                </label>
                @if (Model.Actual!.Imagen != null)
                {
                    <img height="100"
                         width="100"
                         src="data:image;base64,
                    @System.Convert.ToBase64String(
                    Convert.FromBase64String(
                    Model.Actual!.Imagen))" />
                }
                <input type="file"
                       asp-for="FormFile" />
            </div>
        }

        @if (Model.Borrar)
        {
            <div class="popup">
                <div class="pp_del_inner">
                    <h3>
                        Mensaje
                    </h3>

                    <h4>
                        ¿Quiere borrar la Reseña con información
                        Cliente @Model.Actual!.Cliente,
                        Producto @Model.Actual!.Producto,
                        @Model.Actual!.Calificacion,
                        @Model.Actual!.Comentario?
                    </h4>
                    <input type="submit"
                           value="Cancelar"
                           class="btn btn-secondary"
                           asp-page-handler="BtConsultar" />
                    <input type="submit"
                           value="Borrar"
                           class="btn btn-secondary"
                           asp-page-handler="BtBorrar" />
                </div>
            </div>
        }

        @if (!Model.Formulario)
        {
            <br />
            <br />
            <div class="containers_vn panel panel-default">
                <table class="tb_data table table-striped table-bordered table-hover">
                    <tr>
                        <th>Cliente</th>
                        <th>Producto</th>
                        <th>Calificación</th>
                        <th>Comentario</th>
                        <th>Fecha</th>
                        <th>Imagen</th>
                        <th>Acción</th>
                    </tr>
                    @if (Model != null && Model.Lista != null)
                    {
                        foreach (var elemento in Model.Lista)
                        {
                            <tr>
                                <td>@elemento.Cliente</td>
                                <td>@elemento.Producto</td>
                                <td>@elemento.Calificacion</td>
                                <td>@elemento.Comentario</td>
                                <td>@elemento.Fecha</td>
                                <td>
                                    @if (elemento.Imagen != null)
                                    {
                                        <img height="60"
                                             width="60"
                                             src="data:image;base64,
                                        @System.Convert.ToBase64String(
                                        Convert.FromBase64String(elemento.Imagen))" />
                                    }
                                    <td>
                                <td>
                                    <input type="submit"
                                           value="Editar"
                                           class="btn btn-secondary"
                                           asp-page-handler="BtEditar"
                                           asp-route-data="@elemento.Id" />
                                    <input type="submit"
                                           value="Borrar"
                                           class="btn btn-secondary"
                                           asp-page-handler="BtPregBorrar"
                                           asp-route-data="@elemento.Id" />
                                </td>
                            </tr>
                        }
                    }
                </table>
            </div>
        }

    </div>
</form>